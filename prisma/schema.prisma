generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Grader {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  mustReset    Boolean  @default(false)
  createdAt    DateTime @default(now())

  grades       Grade[]
  ratings      Rating[]
  photos       ApplicantPhoto[]
  resumes      ApplicantResume[]
  resetTokens  PasswordResetToken[]
  groups       GroupGrader[]
  notes        Note[]
  infoSessionEdits InfoSessionAttendee[] @relation("InfoSessionEdits")
  infoSessionAdds  InfoSessionAttendee[] @relation("InfoSessionAdds")
  verdictEdits     DeliberationVerdict[] @relation("VerdictEdits")
  interviewsAsFirst  InterviewSlot[] @relation("Interviewer1")
  interviewsAsSecond InterviewSlot[] @relation("Interviewer2")
  interviewNotes     InterviewNote[]
  interviewerAliases InterviewerAlias[]
  interviewReportEdits InterviewReport[]
  interviewScorecards InterviewScorecard[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  graderId  String
  grader    Grader    @relation(fields: [graderId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Applicant {
  id            String   @id @default(cuid())
  // dedupe key so re-importing the same CSV updates instead of duplicating
  dedupeKey     String   @unique

  submittedAt   DateTime?
  uclaEmail     String
  contactEmail  String?
  fullName      String
  pronouns      String?
  gradYear      String?
  majors        String?
  minors        String?
  resumeUrl     String?

  roleRaw       String?
  roleCategory  String   @default("UNKNOWN") // DEVELOPER | DESIGNER | BOTH | OTHER | UNKNOWN

  qLookingForward String?
  qInitiative     String?
  qCommunity      String?
  links           String?
  anythingElse    String?

  raw           String   @default("{}")
  createdAt     DateTime @default(now())

  // The outcome of the written round, saved from Rankings. Anyone matched from
  // the meet and greet sign-up sheet is marked PASSED too.
  screeningStatus String @default("PENDING") // PENDING | PASSED | REJECTED

  // Set by dragging the applicant in Rankings: a stand-in for their average
  // that sorts them where they were dropped and is judged against the cutoff.
  // Null means they sit wherever their average puts them.
  rankScore       Float?

  grades        Grade[]
  photo         ApplicantPhoto?
  resume        ApplicantResume?
  ratings       Rating[]
  cohort        CohortMember?
  nameMatches   NameMatch[]
  placements    Placement[]
  notes         Note[]
  deliberation  DeliberationVerdict?
  interviewDeliberation InterviewDeliberationVerdict?
  interviewSlots InterviewSlot[]

  @@index([roleCategory])
  @@index([screeningStatus])
}

// The mugshot. Stored in the database rather than on disk so it survives a
// redeploy — hosted Node filesystems are ephemeral — and so a backup of the
// database is a backup of the photos too. One per applicant; re-uploading
// replaces it.
model ApplicantPhoto {
  id           String   @id @default(cuid())
  applicantId  String   @unique
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  data         Bytes
  mimeType     String
  byteSize     Int
  uploadedById String?
  uploadedBy   Grader?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt
}

// The resume, uploaded from the zip of Google Form file responses. Kept in the
// database for the same reasons as the photo: the Drive links in the CSV only
// open for people the files were shared with, and hosted filesystems vanish.
model ApplicantResume {
  id           String   @id @default(cuid())
  applicantId  String   @unique
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  data         Bytes
  mimeType     String
  fileName     String
  byteSize     Int
  uploadedById String?
  uploadedBy   Grader?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt
}

// Pieces of a resume too big for one request (the platform caps bodies at
// 4.5MB). They wait here until the last one arrives, then are joined into the
// ApplicantResume and deleted.
model ResumeUploadPart {
  uploadId    String
  index       Int
  applicantId String
  data        Bytes
  createdAt   DateTime @default(now())

  @@id([uploadId, index])
}

// The Rankings cutoff for one graduation year. Shared, so everyone looking at
// Rankings sees the same line; a year with no row sits at the default.
model RankingCutoff {
  gradYear  String   @id
  cutoff    Float
  updatedAt DateTime @updatedAt
}

// Interview selection runs on these, not on the rubric scores. One per grader
// per applicant, like a grade, so the ranking can aggregate across the team.
model Rating {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  graderId    String
  grader      Grader   @relation(fields: [graderId], references: [id], onDelete: Cascade)

  value       String   // DOUBLE_UP | UP | MAYBE | DOWN
  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([applicantId, graderId])
  @@index([applicantId])
}

model Grade {
  id             String   @id @default(cuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  graderId       String
  grader         Grader   @relation(fields: [graderId], references: [id], onDelete: Cascade)

  technical      Int
  thoughtfulness Int
  initiative     Int
  communityFit   Int

  technicalNote      String?
  thoughtfulnessNote String?
  initiativeNote     String?
  communityFitNote   String?
  overallNote        String?

  // A deliberate override rather than a scored read: ACCEPT forces every
  // criterion to 5, REJECT forces every criterion to 1. Whoever sets one must
  // explain it in overallNote, and the reason is readable from Rankings.
  autoDecision       String?  // ACCEPT | REJECT

  // The grader's gut call on whether this person goes to the next round.
  // Shown as a thumbs tally in Rankings but never feeds the average or the
  // order. Null on grades saved before it existed.
  nextRound          String?  // PASS | FAIL

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([applicantId, graderId])
  @@index([applicantId])
}

// --- meet and greet ----------------------------------------------------------
//
// A cohort is one hour-long session of the meet and greet, read from one
// column of the sign-up sheet. Everyone in it
// is in the same room; each round splits the room into small symbol groups
// ("Blue Star"), and people move to a new symbol between rounds.

model Cohort {
  id        String    @id @default(cuid())
  name      String
  startsAt  DateTime?
  capacity  Int?
  // Where it is, from the sheet's header ("Boelter Hall - Room 5440").
  location  String?
  // Which column of the sign-up sheet this session is. The column, not the
  // time, is what identifies it: a tentative time can still move.
  sheetCol  Int?      @unique
  createdAt DateTime  @default(now())

  members   CohortMember[]
  signups   Signup[]
  groups    Group[]
  rounds    Round[]
}

// Each passed applicant attends exactly one cohort.
model CohortMember {
  id          String    @id @default(cuid())
  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  cohortId    String
  cohort      Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  checkedInAt DateTime?
  // Put here by a person rather than by the sheet. Reading the sheet leaves
  // them where they are, whatever it says about them.
  byHand      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([cohortId])
}

// A name on the sign-up sheet that hasn't been tied to an application yet.
// Matched names don't need a row: they are CohortMembers.
model Signup {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([cohortId])
}

// A sheet name someone tied to an applicant by hand, kept so refreshing from
// the sheet doesn't ask again. `name` is the normalised spelling.
model NameMatch {
  name        String    @id
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

// The sign-up sheet the sessions are read from. One row, id "main".
model EventSheet {
  id       String   @id @default("main")
  url      String
  syncedAt DateTime @default(now())
}

// A symbol group. It belongs to the cohort, not to a round: the symbols are
// spots in the room, and people rotate through them.
model Group {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  index     Int
  color     String
  shape     String

  graders    GroupGrader[]
  placements Placement[]
  notes      Note[]

  @@unique([cohortId, index])
}

// Graders stay at one symbol for the whole hour, so this has no round.
// If graders start rotating between rounds, add a roundId here (and to the
// unique key) and look it up per round wherever GroupGrader is read.
model GroupGrader {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  graderId String
  grader   Grader @relation(fields: [graderId], references: [id], onDelete: Cascade)

  @@unique([groupId, graderId])
  @@index([graderId])
}

model Round {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  number   Int

  placements Placement[]
  notes      Note[]

  @@unique([cohortId, number])
}

// Where one applicant sits in one round.
model Placement {
  id          String    @id @default(cuid())
  roundId     String
  round       Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([roundId, applicantId])
  @@index([groupId])
}

// What a grader noticed about someone. Written during the event, so it carries
// the round and group it was written in; the verdict itself is a Rating.
model Note {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  graderId    String
  grader      Grader    @relation(fields: [graderId], references: [id], onDelete: Cascade)
  roundId     String?
  round       Round?    @relation(fields: [roundId], references: [id], onDelete: SetNull)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([applicantId])
  @@index([graderId])
}

// --- info session ------------------------------------------------------------
//
// Someone who came to an info session, from the sign-in sheet CSV or added by
// hand by a grader who saw them there. Not linked
// to an Applicant by id: most people come before they apply, so the match is
// made by email (or failing that, name) whenever a page reads them — see
// lib/infosession.js. That way a later application is picked up on its own.
model InfoSessionAttendee {
  id          String   @id @default(cuid())
  // Lowercased. Optional for people added by hand; the sheet fills it in.
  email       String?  @unique
  name        String
  // False for people a grader added before the sheet was imported. The import
  // merges into them by name rather than adding them twice.
  onSheet     Boolean  @default(false)
  addedById   String?
  addedBy     Grader?  @relation("InfoSessionAdds", fields: [addedById], references: [id], onDelete: SetNull)

  // Shown in Rankings next to the graders' reviews.
  note        String?
  // Counts in Rankings exactly like an auto accept from the grading page.
  // Requires a note, for the same reason.
  autoAccept  Boolean  @default(false)
  updatedById String?
  updatedBy   Grader?  @relation("InfoSessionEdits", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- deliberations -----------------------------------------------------------
//
// The shared verdict on someone after round 3 of the group work event, given
// by admins in Deliberations. One per applicant, so the whole team sees the
// same ranking. `position` is where they sit in that ranking, 0 at the top.
model DeliberationVerdict {
  id          String    @id @default(cuid())
  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  verdict     String    // STRONG_ACCEPT | YES | MAYBE | STRONG_NO | COME_BACK
  position    Int
  // Moving on to the coffee chats. Strong accepts and yeses pass on their own;
  // a maybe passes only when an admin passes it by hand.
  passedToInterview Boolean @default(false)
  updatedById String?
  updatedBy   Grader?   @relation("VerdictEdits", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

// The final-interview deliberations board. Unlike DeliberationVerdict, the
// bucket a candidate sits in (strong accept / soft yes / maybe / no) and
// their score are computed from their InterviewScorecards, not set by hand —
// this table only remembers manual drag order within a bucket. A row exists
// for every candidate with at least one interview verdict in, and is dropped
// once they have none (see lib/interviewDeliberation.js).
model InterviewDeliberationVerdict {
  id          String    @id @default(cuid())
  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  position    Int
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

// --- interviews --------------------------------------------------------------
//
// The schedule is read from a live Google Sheet: one row per room-and-time
// slot, filled in by hand as candidates and interviewers are assigned. Synced
// on every read (see lib/interviews.js), not just by hand, so the portal
// tracks the sheet without anyone having to remember to press a button.

// The interview schedule sheet. One row, id "main", same shape as EventSheet.
model InterviewSheet {
  id       String   @id @default("main")
  url      String
  syncedAt DateTime @default(now())
}

// One room-and-time slot from the schedule. Identified by day, start time and
// room — not by sheet row — so a slot keeps its notes even if rows above it
// shift. `candidateRaw`/`interviewer1Raw`/`interviewer2Raw` are the sheet's
// text; the matched ids are resolved on sync and left null when nothing
// matches, so the raw name is always there to show or hand-match.
model InterviewSlot {
  id          String   @id @default(cuid())
  day         String
  startRaw    String
  endRaw      String
  room        String
  status      String?
  roleRaw     String?
  // Parsed from day + startRaw so the schedule can sort chronologically —
  // neither is sortable as plain text ("10:00 AM" < "9:00 AM" alphabetically).
  sortKey     Int      @default(0)

  candidateRaw   String?
  candidateId    String?
  candidate      Applicant? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  interviewer1Raw String?
  interviewer1Id  String?
  interviewer1    Grader? @relation("Interviewer1", fields: [interviewer1Id], references: [id], onDelete: SetNull)

  interviewer2Raw String?
  interviewer2Id  String?
  interviewer2    Grader? @relation("Interviewer2", fields: [interviewer2Id], references: [id], onDelete: SetNull)

  checkRaw    String?
  notes       InterviewNote[]
  report      InterviewReport?
  scorecards  InterviewScorecard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, startRaw, room])
  @@index([candidateId])
  @@index([interviewer1Id])
  @@index([interviewer2Id])
  @@index([sortKey])
}

// What an interviewer noticed, kept with the slot they wrote it in.
model InterviewNote {
  id        String   @id @default(cuid())
  slotId    String
  slot      InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  graderId  String
  grader    Grader   @relation(fields: [graderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@index([graderId])
}

// A sheet first name ("Jay") tied by hand to a grader, for when more than one
// grader shares it. Remembered so a later sync doesn't ask again.
model InterviewerAlias {
  name     String @id
  graderId String
  grader   Grader @relation(fields: [graderId], references: [id], onDelete: Cascade)
}

// The interview guide's shared parts: one document per slot, since the two
// interviewers switch off asking/typing and are writing up the same
// conversation. `notesJson` is keyed by the script's question ids — a loose
// shape, like Applicant.raw, since the script itself can change. The rubric
// and verdict are NOT here — those are each interviewer's own independent
// read on the candidate, kept on InterviewScorecard instead.
model InterviewReport {
  id          String        @id @default(cuid())
  slotId      String        @unique
  slot        InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  track       String? // NEW | EXPERIENCED
  scriptOverride String? // dev | design | dev-pm | design-pm — overrides the role-based auto pick
  notesJson   String        @default("{}")
  updatedById String?
  updatedBy   Grader?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime      @updatedAt
}

// One interviewer's own rubric scores, verdict and explanation for a slot.
// Only its own grader can edit it, but the guide shows every grader's
// scorecard for a slot to anyone viewing it, labeled by grader name.
model InterviewScorecard {
  id           String        @id @default(cuid())
  slotId       String
  slot         InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  graderId     String
  grader       Grader        @relation(fields: [graderId], references: [id], onDelete: Cascade)
  rubricJson   String        @default("{}") // category id -> 1-5
  verdict      String? // STRONG_ACCEPT | SOFT_YES | NO
  generalNotes String?
  updatedAt    DateTime      @updatedAt

  @@unique([slotId, graderId])
}

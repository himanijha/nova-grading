generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Grader {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  mustReset    Boolean  @default(false)
  createdAt    DateTime @default(now())

  grades       Grade[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  graderId  String
  grader    Grader    @relation(fields: [graderId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Applicant {
  id            String   @id @default(cuid())
  // dedupe key so re-importing the same CSV updates instead of duplicating
  dedupeKey     String   @unique

  submittedAt   DateTime?
  uclaEmail     String
  contactEmail  String?
  fullName      String
  pronouns      String?
  gradYear      String?
  majors        String?
  minors        String?
  resumeUrl     String?

  roleRaw       String?
  roleCategory  String   @default("UNKNOWN") // DEVELOPER | DESIGNER | BOTH | OTHER | UNKNOWN

  qLookingForward String?
  qInitiative     String?
  qCommunity      String?
  links           String?
  anythingElse    String?

  raw           String   @default("{}")
  createdAt     DateTime @default(now())

  grades        Grade[]

  @@index([roleCategory])
}

model Grade {
  id             String   @id @default(cuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  graderId       String
  grader         Grader   @relation(fields: [graderId], references: [id], onDelete: Cascade)

  technical      Int
  thoughtfulness Int
  initiative     Int
  communityFit   Int

  technicalNote      String?
  thoughtfulnessNote String?
  initiativeNote     String?
  communityFitNote   String?
  overallNote        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([applicantId, graderId])
  @@index([applicantId])
}

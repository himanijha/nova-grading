# Local development: this matches the Postgres that `docker compose up -d` starts.
# For a hosted database (Neon/Supabase), paste the connection string they give
# you instead — it will start with postgresql:// — and keep ?sslmode=require.
DATABASE_URL="postgresql://nova:nova@localhost:55432/nova"

# Must be a long random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-please-0123456789"

# Local development database. For Neon/Supabase, paste the connection string
# they give you (it will start with postgresql://) and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Must be a long random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-please-0123456789"
